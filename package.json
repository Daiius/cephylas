{
  "name": "cephylas",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:core && pnpm --filter web dev",
    "dev:core": "docker compose -f compose.yml -f compose.dev.yml up -d cephylas",
    "dev:web": "pnpm --filter web dev",
    "down": "docker compose -f compose.yml -f compose.dev.yml down",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
